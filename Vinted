// ---- CALENDAR ----
document.getElementById('cal-prev').addEventListener('click', () => { calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; } renderCal(); });
document.getElementById('cal-next').addEventListener('click', () => { calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; } renderCal(); });

function getSalesForDay(y, m, d) {
  const result = [];
  data.forEach(item => {
    if (item.tipo === 'articolo' && item.stato === 'venduto' && item.dataVendita) {
      const dd = new Date(item.dataVendita);
      if (dd.getFullYear() === y && dd.getMonth() === m && dd.getDate() === d) result.push({ nome: item.nome, profit: profit(item) });
    }
    if (item.tipo === 'lotto') {
      (item.items || []).forEach(i => {
        if (i.stato === 'venduto' && i.dataVendita) {
          const dd = new Date(i.dataVendita);
          if (dd.getFullYear() === y && dd.getMonth() === m && dd.getDate() === d) result.push({ nome: i.nome + ' (lotto: ' + item.nome + ')', profit: parseFloat(i.vendita || 0) });
        }
      });
    }
  });
  return result;
}

function renderCal() {
  data = load();
  document.getElementById('cal-month-label').textContent = monthName(calMonth, calYear);

  const firstDay = new Date(calYear, calMonth, 1).getDay(); // 0=Sun
  const firstDayMon = (firstDay + 6) % 7; // Mon=0
  const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

  const grid = document.getElementById('cal-grid');
  grid.innerHTML = '';
  ['L','M','M','G','V','S','D'].forEach(l => {
    const d = document.createElement('div'); d.className = 'cal-day-label'; d.textContent = l; grid.appendChild(d);
  });

  for (let i = 0; i < firstDayMon; i++) {
    const d = document.createElement('div'); d.className = 'cal-day other-month'; grid.appendChild(d);
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const d = document.createElement('div'); d.className = 'cal-day';
    const dayDate = new Date(calYear, calMonth, day);
    const t = new Date(); t.setHours(0,0,0,0);
    dayDate.setHours(0,0,0,0);
    if (dayDate.getTime() === t.getTime()) d.classList.add('today');
    const sales = getSalesForDay(calYear, calMonth, day);
    if (sales.length) d.classList.add('has-sales');
    if (calSelectedDay === day) d.classList.add('selected');
    d.textContent = day;
    d.addEventListener('click', () => {
      calSelectedDay = day;
      renderCal();
    });
    grid.appendChild(d);
  }

  // Month summary
  let totSpese = 0, totIncasso = 0;
  data.forEach(item => {
    if (item.tipo === 'articolo' && item.stato === 'venduto' && item.dataVendita) {
      const dd = new Date(item.dataVendita);
      if (dd.getMonth() === calMonth && dd.getFullYear() === calYear) {
        totIncasso += parseFloat(item.vendita || 0);
        totSpese += parseFloat(item.acquisto || 0);
      }
    }
    if (item.tipo === 'lotto') {
      let lottoContribuisce = false;
      (item.items || []).forEach(i => {
        if (i.stato === 'venduto' && i.dataVendita) {
          const dd = new Date(i.dataVendita);
          if (dd.getMonth() === calMonth && dd.getFullYear() === calYear) {
            totIncasso += parseFloat(i.vendita || 0);
            lottoContribuisce = true;
          }
        }
      });
      if (lottoContribuisce) totSpese += parseFloat(item.acquisto || 0);
    }
  });
  const netto = totIncasso - totSpese;

  document.getElementById('cal-month-summary').innerHTML = `
    <div class="month-summary-title">📊 ${monthName(calMonth, calYear)}</div>
    <div class="month-summary-grid">
      <div class="ms-item"><div class="ms-val" style="color:var(--red)">${fmt(totSpese)}</div><div class="ms-label">Spese</div></div>
      <div class="ms-item"><div class="ms-val" style="color:var(--accent)">${fmt(totIncasso)}</div><div class="ms-label">Incasso</div></div>
      <div class="ms-item"><div class="ms-val" style="color:${netto>=0?'var(--accent)':'var(--red)'}">${netto>=0?'+':''}${fmt(netto)}</div><div class="ms-label">Netto</div></div>
    </div>
  `;

  if (calSelectedDay) {
    const sales = getSalesForDay(calYear, calMonth, calSelectedDay);
    document.getElementById('cal-day-label').textContent = `${calSelectedDay} ${new Date(calYear, calMonth, calSelectedDay).toLocaleDateString('it-IT', { month: 'long' })}`;
    const sl = document.getElementById('cal-sales-list');
    sl.innerHTML = '';
    if (!sales.length) {
      sl.innerHTML = '<div style="color:var(--text2);font-size:13px;text-align:center;padding:16px">Nessuna vendita</div>';
    } else {
      sales.forEach(s => {
        const div = document.createElement('div'); div.className = 'cal-sale-item';
        div.innerHTML = `<div class="cal-sale-name">${s.nome}</div><div class="cal-sale-profit ${s.profit >= 0 ? 'green' : ''}">${s.profit !== null ? (s.profit >= 0 ? '+' : '') + fmt(s.profit) : fmt(s.profit)}</div>`;
        sl.appendChild(div);
      });
    }
  }
}

// ---- RENDER STATS ----
function renderStats() {
  data = load();
  const months = {};
  data.forEach(item => {
    if (item.tipo === 'articolo' && item.stato === 'venduto' && item.dataVendita) {
      const d = new Date(item.dataVendita);
      const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      if (!months[key]) months[key] = { incasso: 0, spese: 0, count: 0 };
      months[key].incasso += parseFloat(item.vendita || 0);
      months[key].spese += parseFloat(item.acquisto || 0);
      months[key].count++;
    }
    if (item.tipo === 'lotto') {
      const lottoMonths = new Set();
      (item.items || []).forEach(i => {
        if (i.stato === 'venduto' && i.dataVendita) {
          const d = new Date(i.dataVendita);
          const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
          if (!months[key]) months[key] = { incasso: 0, spese: 0, count: 0 };
          months[key].incasso += parseFloat(i.vendita || 0);
          months[key].count++;
          lottoMonths.add(key);
        }
      });
      lottoMonths.forEach(k => { months[k].spese += parseFloat(item.acquisto || 0); });
    }
  });

  const el = document.getElementById('stats-content');
  el.innerHTML = '';

  // Overall
  const totIncasso = Object.values(months).reduce((s, m) => s + m.incasso, 0);
  const totSpese = Object.values(months).reduce((s, m) => s + m.spese, 0);
  const totNetto = totIncasso - totSpese;
  const totVendite = Object.values(months).reduce((s, m) => s + m.count, 0);

  const overall = document.createElement('div');
  overall.innerHTML = `
    <div class="stat-grid">
      <div class="stat-card full" style="background:linear-gradient(135deg,#0d2e22,#162840);border-color:var(--accent2)">
        <div class="stat-label">Guadagno totale</div>
        <div class="stat-val ${totNetto>=0?'green':'red'}">${totNetto>=0?'+':''}${fmt(totNetto)}</div>
        <div class="stat-sub">${totVendite} vendite · ${fmt(totSpese)} spese · ${fmt(totIncasso)} incassati</div>
      </div>
    </div>
  `;
  el.appendChild(overall);

  // By month
  const sortedMonths = Object.keys(months).sort().reverse();
  if (!sortedMonths.length) {
    el.innerHTML += '<div class="empty"><div class="empty-icon">📈</div><div class="empty-title">Nessun dato</div><div class="empty-sub">Le statistiche appariranno dopo le prime vendite</div></div>';
    return;
  }

  const secTitle = document.createElement('div');
  secTitle.className = 'section-title';
  secTitle.style.marginTop = '8px';
  secTitle.textContent = 'Per mese';
  el.appendChild(secTitle);

  sortedMonths.forEach(key => {
    const m = months[key];
    const [y, mo] = key.split('-');
    const netto = m.incasso - m.spese;
    const card = document.createElement('div');
    card.className = 'month-summary';
    card.innerHTML = `
      <div class="month-summary-title">📅 ${monthName(parseInt(mo)-1, parseInt(y))}</div>
      <div class="month-summary-grid">
        <div class="ms-item"><div class="ms-val" style="color:var(--red)">${fmt(m.spese)}</div><div class="ms-label">Spese</div></div>
        <div class="ms-item"><div class="ms-val" style="color:var(--accent)">${fmt(m.incasso)}</div><div class="ms-label">Incasso</div></div>
        <div class="ms-item"><div class="ms-val" style="color:${netto>=0?'var(--accent)':'var(--red)'}">${netto>=0?'+':''}${fmt(netto)}</div><div class="ms-label">Netto</div></div>
      </div>
      <div style="font-size:11px;color:var(--text2);margin-top:8px">${m.count} vendite</div>
    `;
    el.appendChild(card);
  });
}

// ---- INIT ----
renderHome();
renderCal();
</script>
</body>
</html>
