  </div>
</div>

<!-- MODAL SEGNA VENDUTO (articolo singolo) -->
<div class="modal-overlay" id="modal-vendi">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">Segna come venduto</div>
    <div class="field">
      <label>Prezzo vendita (€)</label>
      <input type="number" id="vendi-prezzo" placeholder="0.00" step="0.01" min="0">
    </div>
    <div class="field">
      <label>Data vendita</label>
      <input type="date" id="vendi-data">
    </div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button class="btn btn-outline" id="btn-cancel-vendi">Annulla</button>
