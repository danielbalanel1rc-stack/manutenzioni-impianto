// ---- CARD BUILDER ----
function buildCard(item) {
  const div = document.createElement('div');
  div.className = 'card';

  // Image
  const imgDiv = document.createElement('div');
  imgDiv.className = 'card-img';
  if (item.foto) {
    const img = document.createElement('img'); img.src = item.foto; imgDiv.appendChild(img);
  } else {
    imgDiv.innerHTML = `<div class="card-img-placeholder"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg><span>Nessuna foto</span></div>`;
  }
  div.appendChild(imgDiv);

  const inner = document.createElement('div');
  inner.className = 'card-inner';

  // Row: name + badge
  const row = document.createElement('div');
  row.className = 'card-row';
  const name = document.createElement('div');
  name.className = 'card-name';
  name.textContent = item.nome;
  row.appendChild(name);

  const badge = document.createElement('span');
  badge.className = 'badge';
  if (item.tipo === 'lotto') { badge.classList.add('badge-lotto'); badge.textContent = '🗃️ Lotto'; }
  else if (item.stato === 'venduto') { badge.classList.add('badge-venduto'); badge.textContent = '✓ Venduto'; }
  else { badge.classList.add('badge-invendita'); badge.textContent = '⏳ In vendita'; }
  row.appendChild(badge);
  inner.appendChild(row);

  // Prices
  const priceRow = document.createElement('div');
  priceRow.className = 'price-row';

  const aq = document.createElement('div'); aq.className = 'price-box';
  aq.innerHTML = `<div class="price-box-label">Acquisto</div><div class="price-box-val red">${fmt(item.acquisto)}</div>`;
  priceRow.appendChild(aq);

  if (item.tipo === 'lotto') {
    const totVen = (item.items || []).reduce((s, i) => s + (i.stato === 'venduto' ? parseFloat(i.vendita || 0) : 0), 0);
    const totPoten = (item.items || []).reduce((s, i) => s + parseFloat(i.vendita || 0), 0);
    const vb = document.createElement('div'); vb.className = 'price-box';
    vb.innerHTML = `<div class="price-box-label">Venduto</div><div class="price-box-val green">${fmt(totVen)}</div>`;
    priceRow.appendChild(vb);
    const pb = document.createElement('div'); pb.className = 'price-box';
    pb.innerHTML = `<div class="price-box-label">Totale pot.</div><div class="price-box-val">${fmt(totPoten)}</div>`;
    priceRow.appendChild(pb);
  } else {
    const vb = document.createElement('div'); vb.className = 'price-box';
    vb.innerHTML = `<div class="price-box-label">Vendita</div><div class="price-box-val green">${fmt(item.vendita)}</div>`;
    priceRow.appendChild(vb);
  }
  inner.appendChild(priceRow);

  // Profit
  const p = profit(item);
  if (p !== null) {
    const pr = document.createElement('div');
    pr.className = 'profit-row';
    pr.innerHTML = `<span class="profit-label">Guadagno:</span><span class="profit-val ${profitColor(p)}">${p >= 0 ? '+' : ''}${fmt(p)}</span>`;
    inner.appendChild(pr);
  }

  // Actions
  const actions = document.createElement('div');
  actions.className = 'card-actions';

  if (item.tipo === 'lotto') {
    const btnAdd = document.createElement('button');
    btnAdd.className = 'btn btn-primary';
    btnAdd.textContent = '+ Articolo';
    btnAdd.addEventListener('click', () => {
      lottoItemTarget = item.id;
      resetLiModal();
      document.getElementById('modal-lotto-item').classList.add('open');
    });
    actions.appendChild(btnAdd);
  } else if (item.stato !== 'venduto') {
    const btnVendi = document.createElement('button');
    btnVendi.className = 'btn btn-primary';
    btnVendi.textContent = '✓ Vendi';
    btnVendi.addEventListener('click', () => {
      vendiTarget = item.id;
      document.getElementById('vendi-prezzo').value = item.vendita || '';
      document.getElementById('vendi-data').value = new Date().toISOString().slice(0,10);
      document.getElementById('modal-vendi').classList.add('open');
    });
    actions.appendChild(btnVendi);
  }

  const btnEdit = document.createElement('button');
  btnEdit.className = 'btn btn-outline';
  btnEdit.textContent = '✎';
  btnEdit.addEventListener('click', () => {
    editingId = item.id;
    document.getElementById('modal-title').textContent = 'Modifica';
    resetNewModal();
    setType(item.tipo);
    document.getElementById('field-nome').value = item.nome;
    document.getElementById('field-acquisto').value = item.acquisto;
    document.getElementById('field-vendita').value = item.vendita || '';
    document.getElementById('field-stato').value = item.stato || 'in_vendita';
    if (item.dataVendita) { document.getElementById('field-data').value = item.dataVendita; document.getElementById('field-data-wrap').style.display = ''; }
    if (item.foto) {
      newPhotoData = item.foto;
      const pu = document.getElementById('photo-upload-main');
      let img = pu.querySelector('img'); if (!img) { img = document.createElement('img'); pu.appendChild(img); }
      img.src = item.foto;
      const svg = pu.querySelector('svg'); if (svg) svg.style.display = 'none';
      const sp = pu.querySelector('span'); if (sp) sp.style.display = 'none';
    }
    document.getElementById('modal-new').classList.add('open');
  });
  actions.appendChild(btnEdit);

  const btnDel = document.createElement('button');
  btnDel.className = 'btn btn-danger';
  btnDel.textContent = '🗑';
  btnDel.addEventListener('click', () => {
    if (confirm('Eliminare?')) {
      data = data.filter(d => d.id !== item.id);
      save(data);
      renderArticoli();
      renderHome();
    }
  });
  actions.appendChild(btnDel);
  inner.appendChild(actions);

  // Lotto items
  if (item.tipo === 'lotto' && item.items && item.items.length > 0) {
    const li = document.createElement('div');
    li.className = 'lotto-items';
    item.items.forEach(i => {
      const row = document.createElement('div');
      row.className = 'lotto-item';
      const thumb = document.createElement('div');
      thumb.className = 'lotto-item-thumb';
      if (i.foto) { const img = document.createElement('img'); img.src = i.foto; thumb.appendChild(img); }
      else thumb.style.background = 'var(--bg3)';
      row.appendChild(thumb);
      const info = document.createElement('div');
      info.className = 'lotto-item-info';
      info.innerHTML = `<div class="lotto-item-name">${i.nome}</div><div class="lotto-item-prices">${i.stato === 'venduto' ? '✓ Venduto' : '⏳ In vendita'} · ${fmt(i.vendita)}</div>`;
      row.appendChild(info);
      if (i.stato !== 'venduto') {
        const vb = document.createElement('button');
        vb.className = 'btn btn-primary'; vb.style.flex = '0'; vb.style.padding = '6px 10px'; vb.style.fontSize = '11px';
        vb.textContent = 'Vendi';
        vb.addEventListener('click', () => {
          vendiTarget = '__li__' + item.id + '__' + i.id;
          document.getElementById('vendi-prezzo').value = i.vendita || '';
          document.getElementById('vendi-data').value = new Date().toISOString().slice(0,10);
          document.getElementById('modal-vendi').classList.add('open');
        });
        row.appendChild(vb);
      }
      li.appendChild(row);
    });
    inner.appendChild(li);
  }

  div.appendChild(inner);
  return div;
}

