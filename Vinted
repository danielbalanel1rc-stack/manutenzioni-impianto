    </div>
  </div>
</div>

<script>
// ---- STORAGE ----
function load() { try { return JSON.parse(localStorage.getItem('vt_data') || '[]'); } catch { return []; } }
function save(d) { localStorage.setItem('vt_data', JSON.stringify(d)); }

let data = load();
let currentType = 'articolo';
let editingId = null;
let lottoItemTarget = null; // id lotto a cui aggiungere item
let vendiTarget = null;
let currentPage = 'home';
let calYear, calMonth, calSelectedDay;

const today = new Date();
calYear = today.getFullYear();
calMonth = today.getMonth();

// ---- UTILS ----
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2); }
function fmt(n) { return n !== undefined && n !== null && n !== '' ? '€' + parseFloat(n).toFixed(2) : '—'; }
function profit(item) {
  if (item.tipo === 'lotto') {
    const totalVendita = (item.items || []).reduce((s, i) => s + (i.stato === 'venduto' ? parseFloat(i.vendita || 0) : 0), 0);
    return totalVendita - parseFloat(item.acquisto || 0);
  }
  if (item.stato !== 'venduto') return null;
  return parseFloat(item.vendita || 0) - parseFloat(item.acquisto || 0);
}
function profitColor(p) { return p === null ? '' : p >= 0 ? 'green' : 'red'; }
function monthName(m, y) {
  return new Date(y, m, 1).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
}

// ---- NAV ----
document.querySelectorAll('.nav-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const page = btn.dataset.page;
    document.getElementById('page-' + page).classList.add('active');
    currentPage = page;
    if (page === 'home') renderHome();
    if (page === 'articoli') renderArticoli();
    if (page === 'cal') renderCal();
    if (page === 'stats') renderStats();
  });
});

// ---- PHOTO HELPERS ----
function bindPhoto(uploadEl, inputEl, cb) {
  inputEl.addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      let existing = uploadEl.querySelector('img');
      if (!existing) { existing = document.createElement('img'); uploadEl.appendChild(existing); }
      existing.src = e.target.result;
      uploadEl.querySelector('svg') && (uploadEl.querySelector('svg').style.display = 'none');
      uploadEl.querySelector('span') && (uploadEl.querySelector('span').style.display = 'none');
      cb(e.target.result);
    };
    reader.readAsDataURL(file);
  });
}

let newPhotoData = null;
let liPhotoData = null;

bindPhoto(
  document.getElementById('photo-upload-main'),
  document.getElementById('photo-input-main'),
  d => { newPhotoData = d; }
);
bindPhoto(
  document.getElementById('photo-upload-item'),
  document.getElementById('photo-input-item'),
  d => { liPhotoData = d; }
);

// ---- MODAL NEW ----
function resetNewModal() {
  newPhotoData = null;
  document.getElementById('field-nome').value = '';
  document.getElementById('field-acquisto').value = '';
  document.getElementById('field-vendita').value = '';
  document.getElementById('field-stato').value = 'in_vendita';
  document.getElementById('field-data').value = '';
  document.getElementById('field-data-wrap').style.display = 'none';
  const pu = document.getElementById('photo-upload-main');
  const img = pu.querySelector('img');
  if (img) img.remove();
  const svg = pu.querySelector('svg'); if (svg) svg.style.display = '';
