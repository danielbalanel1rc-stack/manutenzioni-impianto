// ---- RENDER HOME ----
function renderHome() {
  data = load();
  const now = new Date();
  const thisMonth = data.filter(item => {
    if (item.tipo === 'articolo' && item.stato === 'venduto' && item.dataVendita) {
      const d = new Date(item.dataVendita);
      return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
    }
    return false;
  });
  const lottoSales = data.filter(item => item.tipo === 'lotto').flatMap(l => (l.items || []).filter(i => {
    if (i.stato === 'venduto' && i.dataVendita) {
      const d = new Date(i.dataVendita);
      return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
    }
    return false;
  }));

  const speseMese = thisMonth.reduce((s, i) => s + parseFloat(i.acquisto || 0), 0);
  const incassoMese = thisMonth.reduce((s, i) => s + parseFloat(i.vendita || 0), 0) + lottoSales.reduce((s, i) => s + parseFloat(i.vendita || 0), 0);
  const guadagnoMese = incassoMese - speseMese - data.filter(d => d.tipo === 'lotto').reduce((s, l) => {
    const hasVenditaMese = (l.items || []).some(i => { if (!i.dataVendita) return false; const d = new Date(i.dataVendita); return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear(); });
    return hasVenditaMese ? s + parseFloat(l.acquisto || 0) : s;
  }, 0);

  const totArticoli = data.length;
  const inVendita = data.filter(d => d.tipo === 'articolo' && d.stato !== 'venduto').length + data.filter(d => d.tipo === 'lotto').reduce((s, l) => s + (l.items || []).filter(i => i.stato !== 'venduto').length, 0);

  document.getElementById('home-subtitle').textContent = monthName(now.getMonth(), now.getFullYear());
  document.getElementById('home-stats').innerHTML = `
    <div class="stat-card"><div class="stat-label">Incasso mese</div><div class="stat-val green">${fmt(incassoMese)}</div></div>
    <div class="stat-card"><div class="stat-label">Spese mese</div><div class="stat-val red">${fmt(speseMese)}</div></div>
    <div class="stat-card full"><div class="stat-label">Guadagno netto</div><div class="stat-val ${guadagnoMese >= 0 ? 'green' : 'red'}">${guadagnoMese >= 0 ? '+' : ''}${fmt(guadagnoMese)}</div><div class="stat-sub">${totArticoli} articoli totali · ${inVendita} in vendita</div></div>
  `;

  const list = document.getElementById('home-list');
  list.innerHTML = '';
  const recent = [...data].slice(0, 5);
  if (!recent.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">📦</div><div class="empty-title">Nessun articolo</div><div class="empty-sub">Premi + per aggiungere il primo</div></div>'; return; }
  recent.forEach(item => list.appendChild(buildCard(item)));
}

