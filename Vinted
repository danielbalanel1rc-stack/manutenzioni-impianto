<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Vinted Tracker</title>
<style>
  :root {
    --bg: #0f1117;
    --bg2: #1a1d27;
    --bg3: #242736;
    --accent: #09c17a;
    --accent2: #06a368;
    --red: #e05555;
    --yellow: #f5c842;
    --text: #f0f2f7;
    --text2: #8b90a7;
    --border: #2e3248;
    --radius: 14px;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif; min-height: 100dvh; overflow-x: hidden; }

  /* TABS */
  #app { display: flex; flex-direction: column; height: 100dvh; }
  .page { display: none; flex: 1; overflow-y: auto; padding: 16px 16px calc(80px + var(--safe-bottom)) 16px; }
  .page.active { display: block; }
  .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg2); border-top: 1px solid var(--border); display: flex; padding-bottom: var(--safe-bottom); z-index: 100; }
  .nav-btn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 10px 0 8px; font-size: 10px; color: var(--text2); background: none; border: none; cursor: pointer; transition: color .2s; }
  .nav-btn.active { color: var(--accent); }
  .nav-btn svg { width: 22px; height: 22px; }

  /* HEADER */
  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; padding-top: 8px; }
  .page-title { font-size: 22px; font-weight: 700; letter-spacing: -.4px; }
  .page-subtitle { font-size: 12px; color: var(--text2); margin-top: 2px; }

  /* STAT CARDS */
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
  .stat-card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; }
  .stat-card.full { grid-column: 1/-1; }
  .stat-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px; }
  .stat-val { font-size: 24px; font-weight: 700; }
  .stat-val.green { color: var(--accent); }
  .stat-val.red { color: var(--red); }
  .stat-val.yellow { color: var(--yellow); }
  .stat-sub { font-size: 11px; color: var(--text2); margin-top: 3px; }

  /* CARDS */
  .card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 12px; overflow: hidden; }
  .card-inner { padding: 14px; }
  .card-img { width: 100%; height: 180px; object-fit: cover; background: var(--bg3); display: flex; align-items: center; justify-content: center; color: var(--text2); font-size: 13px; cursor: pointer; position: relative; }
  .card-img img { width: 100%; height: 100%; object-fit: cover; }
  .card-img-placeholder { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .card-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
  .card-name { font-size: 15px; font-weight: 600; flex: 1; }
  .badge { font-size: 10px; padding: 3px 8px; border-radius: 20px; font-weight: 600; }
  .badge-lotto { background: #2a1f6b; color: #a48fff; border: 1px solid #4a3db8; }
  .badge-articolo { background: #0d2e22; color: var(--accent); border: 1px solid var(--accent2); }
  .badge-venduto { background: #1a2e0d; color: #7edd4e; border: 1px solid #4db82e; }
  .badge-invendita { background: #2e200d; color: var(--yellow); border: 1px solid #b88d0a; }
  .price-row { display: flex; gap: 10px; margin-top: 8px; }
  .price-box { flex: 1; background: var(--bg3); border-radius: 8px; padding: 8px 10px; }
  .price-box-label { font-size: 10px; color: var(--text2); margin-bottom: 2px; }
  .price-box-val { font-size: 15px; font-weight: 700; }
  .price-box-val.green { color: var(--accent); }
  .price-box-val.red { color: var(--red); }
  .profit-row { margin-top: 10px; display: flex; align-items: center; gap: 8px; }
  .profit-label { font-size: 12px; color: var(--text2); }
  .profit-val { font-size: 16px; font-weight: 700; }
  .card-actions { display: flex; gap: 8px; margin-top: 12px; }
  .btn { padding: 9px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; border: none; cursor: pointer; transition: opacity .15s; flex: 1; text-align: center; }
  .btn:active { opacity: .7; }
  .btn-primary { background: var(--accent); color: #000; }
  .btn-outline { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .btn-danger { background: transparent; color: var(--red); border: 1px solid var(--red); flex: 0; padding: 9px 12px; }

  /* LOTTO ITEMS */
  .lotto-items { margin-top: 10px; border-top: 1px solid var(--border); padding-top: 10px; }
  .lotto-item { display: flex; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .lotto-item:last-child { border-bottom: none; }
  .lotto-item-thumb { width: 48px; height: 48px; border-radius: 8px; background: var(--bg3); flex-shrink: 0; overflow: hidden; }
  .lotto-item-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .lotto-item-info { flex: 1; min-width: 0; }
  .lotto-item-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lotto-item-prices { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .lotto-add-btn { background: var(--bg3); border: 1px dashed var(--border); border-radius: 10px; padding: 10px; text-align: center; color: var(--text2); font-size: 13px; cursor: pointer; margin-top: 8px; }

  /* MODAL */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 200; display: none; align-items: flex-end; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--bg2); border-radius: 20px 20px 0 0; width: 100%; max-height: 92dvh; overflow-y: auto; padding: 20px 20px calc(20px + var(--safe-bottom)); }
  .modal-handle { width: 36px; height: 4px; background: var(--border); border-radius: 2px; margin: 0 auto 18px; }
  .modal-title { font-size: 18px; font-weight: 700; margin-bottom: 18px; }

  /* FORM */
  .field { margin-bottom: 14px; }
  .field label { font-size: 12px; color: var(--text2); display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .4px; }
  .field input, .field select, .field textarea { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; color: var(--text); font-size: 15px; font-family: inherit; outline: none; transition: border-color .2s; }
  .field input:focus, .field select:focus { border-color: var(--accent); }
  .field select option { background: var(--bg3); }
  .field-row { display: flex; gap: 10px; }
  .field-row .field { flex: 1; }
  .photo-upload { width: 100%; height: 140px; background: var(--bg3); border: 2px dashed var(--border); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; cursor: pointer; color: var(--text2); font-size: 13px; position: relative; overflow: hidden; }
  .photo-upload img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo-upload input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .type-toggle { display: flex; gap: 8px; }
  .type-btn { flex: 1; padding: 10px; border-radius: 10px; font-size: 13px; font-weight: 600; border: 1px solid var(--border); background: var(--bg3); color: var(--text2); cursor: pointer; text-align: center; transition: all .2s; }
  .type-btn.active { background: var(--accent); color: #000; border-color: var(--accent); }

  /* CALENDAR */
  .cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cal-month { font-size: 18px; font-weight: 700; }
  .cal-arrow { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text); font-size: 18px; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 16px; }
  .cal-day-label { text-align: center; font-size: 10px; color: var(--text2); padding: 4px 0; text-transform: uppercase; }
  .cal-day { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8px; font-size: 12px; cursor: pointer; position: relative; }
  .cal-day.today { background: var(--accent); color: #000; font-weight: 700; }
  .cal-day.has-sales::after { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); position: absolute; bottom: 3px; }
  .cal-day.today.has-sales::after { background: #000; }
  .cal-day.other-month { color: var(--text2); opacity: .4; }
  .cal-day.selected { background: var(--bg3); border: 1px solid var(--accent); }
  .cal-sales-list { margin-top: 4px; }
  .cal-sale-item { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
  .cal-sale-name { font-size: 14px; font-weight: 600; }
  .cal-sale-profit { font-size: 14px; font-weight: 700; }
  .cal-sale-profit.green { color: var(--accent); }

  /* STATS PAGE */
  .month-summary { background: linear-gradient(135deg, #0d2e22, #162840); border: 1px solid var(--accent2); border-radius: var(--radius); padding: 18px; margin-bottom: 16px; }
  .month-summary-title { font-size: 13px; color: var(--accent); margin-bottom: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
  .month-summary-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
  .ms-item { text-align: center; }
  .ms-val { font-size: 18px; font-weight: 700; }
  .ms-label { font-size: 10px; color: var(--text2); margin-top: 2px; }

  /* EMPTY STATE */
  .empty { text-align: center; padding: 60px 20px; color: var(--text2); }
  .empty-icon { font-size: 48px; margin-bottom: 12px; }
  .empty-title { font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .empty-sub { font-size: 13px; }

  /* FAB */
  .fab { position: fixed; bottom: calc(70px + var(--safe-bottom) + 16px); right: 16px; width: 52px; height: 52px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(9,193,122,.4); cursor: pointer; z-index: 90; border: none; font-size: 24px; color: #000; transition: transform .15s; }
  .fab:active { transform: scale(.92); }

  .section-title { font-size: 13px; font-weight: 600; color: var(--text2); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; margin-top: 4px; }

  /* Scrollbar */
  ::-webkit-scrollbar { display: none; }
</style>
</head>
<body>
<div id="app">

  <!-- HOME PAGE -->
  <div id="page-home" class="page active">
    <div class="page-header">
      <div>
        <div class="page-title">Vinted Tracker</div>
        <div class="page-subtitle" id="home-subtitle">Caricamento...</div>
      </div>
    </div>
    <div class="stat-grid" id="home-stats"></div>
    <div class="section-title">Recenti</div>
    <div id="home-list"></div>
